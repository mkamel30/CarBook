# CarBook Android release signing — EXAMPLE TEMPLATE (safe to commit, contains NO real values).
#
# Copy this file to android/keystore.properties (that file is git-ignored) and fill in
# your own keystore. NEVER commit the real keystore.properties or the .jks/.keystore file.
# android/app/build.gradle only loads keystore.properties when it exists; this .example
# is documentation only and is never read by the build.
#
# Keys (uncomment and replace every CHANGE_ME, do not use these literal values):
#   storeFile     = path to the keystore, relative to android/ (or an absolute path)
#   storePassword = keystore password (created via keytool)
#   keyAlias      = alias of the signing key
#   keyPassword   = password of the signing key
#
# storeFile=CHANGE_ME_RELEASE.KEYSTORE
# storePassword=CHANGE_ME
# keyAlias=CHANGE_ME
# keyPassword=CHANGE_ME
