# CarBook environment configuration
#
# Copy to `.env.local` for development. Next.js also reads `.env` and, when
# NODE_ENV=production, `.env.production`. Never commit any of them.

# ─── Storage ──────────────────────────────────────────────────────────────
# Where the SQLite file lives. Defaults to ./car_maintenance.db in the project
# root. On a server, point this outside the checkout so a redeploy can never
# touch live data:
#   CARBOOK_DB_PATH=/var/lib/carbook/car_maintenance.db
CARBOOK_DB_PATH=

# ─── Session signing ──────────────────────────────────────────────────────
# Long random string. REQUIRED in production: auth throws on every request if it
# is missing under NODE_ENV=production, and the failure surfaces as a 500 on
# sign-in rather than at boot. Generate one with:
#   openssl rand -base64 32
# Changing it invalidates every existing session.
JWT_SECRET=

# ─── Google OAuth ─────────────────────────────────────────────────────────
# From https://console.cloud.google.com/apis/credentials. The redirect URI must
# also be registered as an "Authorized redirect URI" on the OAuth client, and
# must match byte-for-byte — including scheme and trailing path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3070/api/auth/callback/google

# Canonical public origin of this deployment, e.g. https://carbook.example.com.
# Used to build the post-login redirect. Set it explicitly behind a reverse
# proxy: the fallback infers the origin from x-forwarded-host, and trusting a
# client-supplied host header is how open redirects happen.
APP_ORIGIN=

# ─── AI providers (all optional) ──────────────────────────────────────────
# With no key configured the app still works: it falls back to the preseeded
# automotive database, the cross-user specs cache, and clearly-labelled
# heuristics. SERVER_* keys are read only on the server and never reach the
# client bundle. The unprefixed names are accepted as aliases.
SERVER_GEMINI_API_KEY=
SERVER_OPENROUTER_API_KEY=

# Per-request deadline for outgoing AI calls, in milliseconds. Default 30000.
AI_TIMEOUT_MS=
